<Window x:Class="ClipPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipPlayer" Width="640" Height="520" MinWidth="420" MinHeight="360"
        KeyDown="OnKeyDown" Closing="OnClosing" UseLayoutRounding="True">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="Öffnen…" Command="{Binding OpenCommand}" AutomationProperties.Name="Audiodateien öffnen" />
      <TextBlock Text="ClipPlayer" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex, Mode=OneWay}"
             SelectionChanged="OnSelectionChanged"
             AutomationProperties.Name="Audiodateien" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Left" Text="{Binding PositionText}" Width="48" VerticalAlignment="Center" />
      <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
      <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" IsEnabled="{Binding CanSeek}" Value="{Binding PositionRatio, Mode=OneWay}"
              PreviewMouseUp="OnPositionReleased" AutomationProperties.Name="Position" />
    </DockPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
      <Button Content="Zurück" Command="{Binding PreviousCommand}" AutomationProperties.Name="Vorherigen Sound abspielen" />
      <Button Content="Play / Pause" Command="{Binding TogglePauseCommand}" AutomationProperties.Name="Wiedergabe pausieren oder starten" />
      <Button Content="Weiter" Command="{Binding NextCommand}" AutomationProperties.Name="Nächsten Sound abspielen" />
      <Button Content="Löschen" Command="{Binding DeleteCommand}" AutomationProperties.Name="Sound in Papierkorb verschieben" />
    </StackPanel>
    <DockPanel Grid.Row="4" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" Text="Lautstärke" VerticalAlignment="Center" Margin="3,0,10,0" />
      <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="Lautstärke" />
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="3,8,3,0" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
