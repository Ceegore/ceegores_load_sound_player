<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <AssemblyName>ClipPlayer.App</AssemblyName>
    <RootNamespace>ClipPlayer.App</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClipPlayer.App.Tests" />
    <ProjectReference Include="..\ClipPlayer.Core\ClipPlayer.Core.csproj" />
    <ProjectReference Include="..\ClipPlayer.Audio.Windows\ClipPlayer.Audio.Windows.csproj" />
  </ItemGroup>
</Project>
